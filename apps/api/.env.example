# CarbonCo API — copier vers .env (ou définir sur Vercel « carbonco-api »).
# Sans DATABASE_URL, l'API tourne en mode dégradé /tmp JSON (utile en dev/CI).

# ── Serveur ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Base de données (Neon) ──────────────────────────────────────────────────
# URL POOLÉE pour l'API (pgbouncer) :
DATABASE_URL=
# URL DIRECTE pour le worker (LISTEN/NOTIFY — ne passe pas par le pooler) :
DATABASE_URL_DIRECT=
# Connexion NON poolée dédiée au runner de migrations (rôle neondb_owner —
# migrations/DDL, jamais le trafic applicatif). PgBouncer en mode transaction
# casse les SET LOCAL / advisory locks de session (cf. 009_rls_force.sql), d'où
# une connexion directe. Consommée UNIQUEMENT par les commandes mutantes du CLI
# (`baseline`/`apply`/`mark-manual-verified`, via db.database.get_admin_db) et
# par le workflow protégé `.github/workflows/db-migrate.yml` — jamais exposée à
# l'application FastAPI. Fallback : si absente en local/CI, le CLI retombe sur
# DATABASE_URL avec un avertissement (jamais bloquant). En production, la
# provisionner comme secret GitHub Actions `DATABASE_ADMIN_URL` (D-4).
DATABASE_ADMIN_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
AUTH_JWT_SECRET=change-me-en-prod
# TOTP (2FA) : clé Fernet base64 32 octets —
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=

# Administrateurs de la PLATEFORME (gestes inter-organisations : lister/créer/
# supprimer une organisation, changer un plan, gérer les comptes d'une autre
# organisation). E-mails séparés par des virgules, rôle `admin` requis en plus.
# Vide par défaut : un admin ne gère que SA propre organisation.
PLATFORM_ADMIN_EMAILS=
# Développement uniquement : 1 pour ensemencer en base les comptes de dev
# (admin/demo/viewer@carbonco.fr, mots de passe publics). Jamais pris en compte
# en production ni en preview.
CARBONCO_SEED_DEV_ACCOUNTS=

# ── Réseau / sécurité ───────────────────────────────────────────────────────
# Origines autorisées EN PLUS des domaines de production du front
# (utils/cors.py) ; localhost:3000/3001/3003 ajoutés hors production.
ALLOWED_ORIGINS=
# Optionnel : remplace l'expression des URL de preview autorisées (par défaut,
# celles du projet Vercel `carbon` de l'équipe).
ALLOWED_ORIGIN_REGEX=
# 1 pour désactiver le rate limit (tests d'intégration) :
RATE_LIMIT_DISABLED=
# RLS FORCE (migration 009) : 1 pour activer (APRÈS validation Neon). Défaut OFF.
RLS_FORCE=0

# ── Ingestion asynchrone (T1.3) ─────────────────────────────────────────────
# inline (défaut) | worker
WORKER_MODE=inline

# ── Stockage objet (T1.6) ───────────────────────────────────────────────────
# local (défaut) | vercel-blob
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.data/storage
BLOB_READ_WRITE_TOKEN=
# Secret de signature des URL locales (HMAC) :
SIGNED_URL_SECRET=change-me

# ── E-mails (T5.3 — OPTIONNEL, SMTP stdlib, aucune dépendance payante) ──────
# Sans EMAIL_ENABLED, tout reste in-app (notifications) — zéro dépendance.
EMAIL_ENABLED=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Tâches quotidiennes (T7.2 / T7.3) ───────────────────────────────────────
# Jeton partagé avec le cron Vercel (apps/carbon /api/cron/evaluate-alerts) :
# /alerts/evaluate, /beges/reminders/run et /suppliers/campaigns/reminders/run
# acceptent ce Bearer (toutes organisations) OU un JWT analyst (sa seule
# organisation). 16 caractères minimum — p. ex. `openssl rand -hex 32`.
CRON_SERVICE_TOKEN=
# Destinataire (optionnel) des rappels d'échéance BEGES par e-mail :
BEGES_REMINDER_EMAIL=
# Destinataire (optionnel) des candidatures partenaires (T7.5) :
PARTNER_NOTIFY_EMAIL=
# Base des liens publics générés (questionnaires fournisseurs /q/{token}) :
FRONTEND_URL=https://carbon-snowy-nine.vercel.app

# ── Observabilité (T1.7) ────────────────────────────────────────────────────
# Optionnel — no-op si absent :
SENTRY_DSN=
