# Carbon app — copy this to .env.local and fill in values
# See: https://vercel.com/docs/environment-variables

# FastAPI backend URL
# Local:      http://localhost:8000
# Production: https://your-api-domain.com  (set via Vercel Dashboard or `vercel env add`)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Secret serveur utilisé pour signer la session démo HttpOnly (HS256).
# Obligatoire sur Vercel ; générer une valeur aléatoire d'au moins 32 octets.
AUTH_JWT_SECRET=

# URL canonique du site (SEO, sitemap, OG). Sans slash final.
# Prod actuelle (tant que D3 non actée) : https://carbon-snowy-nine.vercel.app
NEXT_PUBLIC_SITE_URL=

# Email de contact public (projet non commercialisé — D2)
NEXT_PUBLIC_CONTACT_EMAIL=ludoviclabs@gmail.com

# Observabilité front (T1.7) — optionnel ; no-op si absent
NEXT_PUBLIC_SENTRY_DSN=

# Mesure d'audience Vercel — désactivée tant que la valeur n'est pas exactement "1".
# N'activer qu'après avoir activé l'outil correspondant dans le projet Vercel
# (sinon /_vercel/insights/script.js et /_vercel/speed-insights/script.js
# répondent 404 sur chaque page). Même activés, les scripts ne se chargent
# qu'après un « Tout accepter » explicite dans la bannière cookies.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
NEXT_PUBLIC_ENABLE_SPEED_INSIGHTS=
